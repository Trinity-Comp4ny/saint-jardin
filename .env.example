# Copie para .env e preencha. Nunca comite o .env real.

# Gemini (NLU do agente — lê a mensagem, extrai dados e classifica intenção)
GEMINI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta) — fase 1 em diante
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Transcrição de áudio (Groq Whisper)
GROQ_API_KEY=

# Alerta de handoff (bot do Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agenda de visita no Google Calendar (ADR-0005) — GUARDADO / DESLIGADO.
# Decisão da Raquel (rev. 30/07): o bot NÃO marca visitas, só coleta e repassa.
# O adapter GoogleAgendaVisita existe no código mas está DESCONECTADO do fluxo, então
# estas envs hoje não têm efeito. Ficam documentadas para uma retomada futura.
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_CALENDAR_ID=

# Comportamento
# Delay proposital base (s) + variação aleatória (jitter) para não parecer bot.
# Produção sugerida: DELAY_SEGUNDOS=40, JITTER_SEGUNDOS=60 (responde entre ~40s e ~100s).
DELAY_SEGUNDOS=60
JITTER_SEGUNDOS=0
# MODO_TESTE=true -> resposta IMEDIATA (ignora o delay e processa no próprio
# webhook, sem esperar o cron). Deixe vazio/false em produção.
MODO_TESTE=
# NUMEROS_TESTE: números (separados por vírgula) que podem usar o comando #reset
# para zerar a própria conversa e repetir os testes sem ficar presos no handoff.
# DEIXE VAZIO EM PRODUÇÃO — sem a variável, o comando de reset não existe.
NUMEROS_TESTE=
# Segredo para proteger /api/process (chamado pelo pg_cron)
PROCESS_SECRET=
